# Cloudflare Pages security headers for the ESS Orrery marketing site.
# The site is static with no user input and no forms. The ONE external origin is our own
# self-hosted, cookieless Umami analytics (analytics.ninthstar.org): its tracker script loads
# from there (script-src) and posts pageview events there (connect-src). Nothing else is allowed.
# CSP still locks down framing (clickjacking), object/base, and everything else to self + inline
# (the design ships inline <style>/<script> and a data: favicon). HARDENING TODO before heavy
# traffic: extract the inline JS to /assets/*.js and drop 'unsafe-inline' from script-src (or move
# to per-page hashes). Tracked in the digest.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.ninthstar.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://analytics.ninthstar.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Exercise the vault credential and FAIL LOUDLY if it no longer works.
#
# Deliberately a systemd unit, not a cron line. The OpenBao raft snapshot was a cron job
# that logged "SNAPSHOT FAILED" to a file and exited 1 -- it did that every night for TEN
# DAYS (2026-08-15 .. 08-24) and nothing ever showed it, because cron failures are not
# visible to `systemctl --failed` and nobody reads a logfile that is usually boring.
# A failed unit shows up in `systemctl --failed`, in the post-reboot check, and in the
# unit-failure alerting. That visibility IS the fix.
[Unit]
Description=Exercise the OpenBao credential the credential helper depends on (capability, not presence)
Documentation=file:/opt/projects/esp/Orrery/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vault-credential-probe

# Every 15 minutes. A credential that dies is then known within 15 minutes instead of
# within however many days it takes for a human to try to push to the wrong repo.
[Unit]
Description=Exercise the OpenBao credential the credential helper depends on, every 15 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=15min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target

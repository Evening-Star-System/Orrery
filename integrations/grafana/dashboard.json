{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source that scrapes the orrery textfile metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "ESS Orrery: fleet conformance",
  "uid": "orrery-conformance",
  "tags": ["orrery", "conformance", "drift"],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "box",
        "label": "Box",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(orrery_up, box)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fleet status",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "min(orrery_clean{box=~\"$box\"})", "instant": true, "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DRIFT", "color": "red" }, "1": { "text": "In sync", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Findings at drift or worse",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "sum(orrery_drift_total{box=~\"$box\"})", "instant": true, "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last reconcile",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "max(orrery_last_run_timestamp_seconds{box=~\"$box\"}) * 1000", "instant": true, "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "dateTimeFromNow" } },
      "options": { "colorMode": "none", "graphMode": "none" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Worst severity over time (0 ok, 3 drift, 4 fail)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "orrery_worst_severity{box=~\"$box\"}", "legendFormat": "{{box}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 4, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10 } } }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Checks",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 13 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "orrery_check_status{box=~\"$box\"}", "instant": true, "format": "table", "refId": "A" }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": {
                "0": { "text": "ok", "color": "green" },
                "1": { "text": "info", "color": "blue" },
                "2": { "text": "warn", "color": "yellow" },
                "3": { "text": "DRIFT", "color": "orange" },
                "4": { "text": "FAIL", "color": "red" } } } ] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      }
    }
  ]
}

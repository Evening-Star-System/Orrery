#!/usr/bin/env python3
"""vault-credential-probe: does the credential ACTUALLY still work?

WHY THIS EXISTS (2026-08-24, the seventh recurrence).
Every one of these outages had the same shape: a vault credential died or was re-scoped,
and NOTHING NOTICED until something visible broke days later. Presence was checked;
capability never was. `bao status` needs no token, so a green vault says nothing about
credentials. This vault's hardened `default` policy DENIES auth/token/lookup-self and
sys/mounts, so even `vault-whoami` returning "(none)" is not proof of a bad token.

So this probe EXERCISES the credential against sys/capabilities-self -- the one endpoint
that answers truthfully: a VALID token returns a capability list (even ["deny"]), an
INVALID token returns 403. It compares what the token CAN do against what
`credential-helper paths` says it MUST do, so the expectation is derived from the consumer
and cannot drift.

TWO SIGNALS, NEVER CONFLATED (the 2026-08-09 spine lesson: five days of good syncs looked
stale because failure and freshness shared one marker):
  probe_ok  -- did this probe itself run to completion?
  verdict   -- what did it find about the credential?
A probe that cannot reach the vault reports probe_ok=false and does NOT claim the
credential is broken. Both are written on EVERY run, so a stale file is itself detectable.

VALUE-BLIND. Reads the token from the operator env into memory to authenticate; never
logs it, never puts it in argv, never emits a secret value. Only non-secret vault PATHS
and capability names reach the state file.
"""
from __future__ import annotations
import json, os, socket, subprocess, sys, urllib.error, urllib.request
from datetime import datetime, timezone

ENVF = "/root/.openbao-operator.env"
STATE_DIR = "/var/lib/orrery"
STATE = os.path.join(STATE_DIR, "vault-credentials.json")
ALERT = os.environ.get("ORRERY_ALERT_HOOK", "/usr/local/bin/orrery-alert")
VHOST = "vault.example.com"
REALERT_SECONDS = 86400


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_token(path: str) -> tuple[str | None, str | None]:
    """Return (token, addr). Handles BOTH `BAO_TOKEN=` and `export BAO_TOKEN=`.

    The export prefix is not cosmetic: a `sed -i 's|^BAO_TOKEN=.*|...|'` silently matches
    NOTHING against an `export`-prefixed line, rewriting the file (new mtime) with the old
    token still in it. That exact no-op is why hub-box kept a dead token that LOOKED
    freshly rotated on 2026-08-24. Parse tolerantly here; write with set-vault-token.
    """
    tok = addr = None
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("export "):
                    line = line[len("export "):]
                k, _, v = line.partition("=")
                v = v.strip().strip('"').strip("'")
                if k.strip() == "BAO_TOKEN":
                    tok = v
                elif k.strip() == "BAO_ADDR":
                    addr = v
    except OSError:
        return (None, None)
    return (tok, addr or "http://127.0.0.1:8200")


def required_paths() -> list[tuple[str, str, str]]:
    """(bucket, kind, vault_path) from the credential helper -- the single source of truth."""
    try:
        out = subprocess.run(["credential-helper", "paths"], capture_output=True,
                             timeout=20, text=True)
    except (OSError, subprocess.SubprocessError):
        return []
    rows = []
    for line in out.stdout.splitlines():
        parts = line.split()
        if len(parts) == 3:
            rows.append((parts[0], parts[1], parts[2]))
    return rows


def capabilities(addr: str, token: str, cap_paths: list[str]) -> dict | None:
    body = json.dumps({"paths": cap_paths}).encode()
    req = urllib.request.Request(addr.rstrip("/") + "/v1/sys/capabilities-self",
                                 data=body, method="POST")
    req.add_header("X-Vault-Token", token)      # header, never argv
    req.add_header("Content-Type", "application/json")
    req.add_header("Host", VHOST)               # ess-proxy is name-based
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        # 403 here means the TOKEN ITSELF is rejected -- capabilities-self is allowed for
        # any valid token, so this is the clean invalid-token discriminator.
        return {"__http_error__": e.code}
    except (urllib.error.URLError, socket.timeout, ValueError, OSError):
        return None


def load_prev() -> dict:
    try:
        with open(STATE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def alert(subject: str, body: str) -> None:
    if not os.path.exists(ALERT):
        return
    try:
        subprocess.run([ALERT, subject, body], timeout=60, capture_output=True)
    except (OSError, subprocess.SubprocessError):
        pass


def main() -> int:
    host = socket.gethostname()
    prev = load_prev()
    result = {"checked_at": now(), "host": host, "probe_ok": False,
              "verdict": "UNKNOWN", "missing": [], "detail": {}, "note": None}

    token, addr = read_token(ENVF)
    if not token:
        result["note"] = f"no BAO_TOKEN in {ENVF}"
        write(result, prev)
        return 2

    rows = required_paths()
    if not rows:
        result["note"] = "`credential-helper paths` returned nothing; cannot derive requirements"
        write(result, prev)
        return 2

    # KV v2: the readable path is <mount>/data/<rest>
    cap_of = {}
    for _b, _k, vp in rows:
        mount, _, rest = vp.partition("/")
        cap_of[vp] = f"{mount}/data/{rest}"

    caps = capabilities(addr, token, sorted(set(cap_of.values())))
    if caps is None:
        result["note"] = "vault unreachable (tunnel down?) -- credential NOT assessed"
        write(result, prev)
        return 2
    if "__http_error__" in caps:
        code = caps["__http_error__"]
        result["probe_ok"] = True
        result["verdict"] = "FAIL"
        result["note"] = (f"capabilities-self returned HTTP {code}: the TOKEN ITSELF is "
                          "rejected (invalid or expired), not merely unprivileged")
        result["missing"] = sorted({vp for vp in cap_of})
        write(result, prev)
        return 1

    result["probe_ok"] = True
    missing = []
    for (bucket, kind, vp) in rows:
        cp = cap_of[vp]
        have = caps.get(cp) or caps.get("data", {}).get(cp) or []
        ok = "read" in have or "root" in have
        result["detail"][vp] = {"buckets": sorted(
            {b for (b, _k, v) in rows if v == vp}), "capabilities": have, "ok": ok}
        if not ok:
            missing.append(vp)
    result["missing"] = sorted(set(missing))
    result["verdict"] = "OK" if not result["missing"] else "FAIL"
    write(result, prev)
    return 0 if result["verdict"] == "OK" else 1


def write(result: dict, prev: dict) -> None:
    os.makedirs(STATE_DIR, exist_ok=True)
    # Carry the last good time forward so "when did this last work" survives a bad run.
    result["last_ok_at"] = (result["checked_at"] if result.get("verdict") == "OK"
                            else prev.get("last_ok_at"))
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(result, fh, indent=2, sort_keys=True)
    os.replace(tmp, STATE)   # atomic: a reader never sees a half-written file
    os.chmod(STATE, 0o644)   # non-secret by construction; the Orrery check reads it

    bad = result["verdict"] == "FAIL" or not result["probe_ok"]
    was_bad = prev.get("verdict") == "FAIL" or (prev and not prev.get("probe_ok", True))
    last_alert = prev.get("last_alert_at")
    due = True
    if bad and was_bad and last_alert:
        try:
            prior = datetime.strptime(last_alert, "%Y-%m-%dT%H:%M:%SZ").replace(
                tzinfo=timezone.utc)
            due = (datetime.now(timezone.utc) - prior).total_seconds() >= REALERT_SECONDS
        except ValueError:
            due = True
    if bad and due:
        lines = [f"host: {result['host']}", f"checked: {result['checked_at']}",
                 f"probe_ok: {result['probe_ok']}", f"verdict: {result['verdict']}",
                 f"last worked: {result.get('last_ok_at') or 'unknown'}", ""]
        if result.get("note"):
            lines += [str(result["note"]), ""]
        if result["missing"]:
            lines.append("Vault paths the credential helper needs but the token CANNOT read:")
            lines += [f"  - {m}" for m in result["missing"]]
            lines += ["", "Effect: those git identities cannot arm in ANY session or repo."]
        lines += ["", "Fix: run your token-mint script (see your ops notes)."]
        alert(f"[{result['host']}] VAULT CREDENTIAL {result['verdict']}", "\n".join(lines))
        result["last_alert_at"] = now()
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(result, fh, indent=2, sort_keys=True)
        os.replace(tmp, STATE)
    elif not bad and was_bad:
        alert(f"[{result['host']}] vault credential RECOVERED",
              f"All {len(result['detail'])} required vault paths readable again "
              f"as of {result['checked_at']}.")


if __name__ == "__main__":
    sys.exit(main())

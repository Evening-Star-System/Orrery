#!/usr/bin/env python3
"""fix-vault-credentials: ONE command that repairs every vault credential on the fleet.

    printf '%s' '<break-glass-or-userpass-token>' | fix-vault-credentials

Run on HUB-BOX (the vault lives here; work-box cannot reach in). The admin token is read on
STDIN so it never lands in argv, ps, or shell history.

WHY THIS EXISTS. On 2026-08-24 a new work-box token was minted as
    bao token create -policy=work-ops -policy=default
which REPLACED the policy set instead of adding to it. The `scm-read` policy was silently
dropped, so 7 of 8 git identities stopped being able to arm in any session or repo. That is
the seventh outage of this family. The defect is that a human hand-typed the policy list.

This script removes that step. The policy is DERIVED from `credential-helper paths` -- the
credential helper's own bucket maps -- so the token is minted against what the consumer
actually needs, and the two cannot drift. Adding a bucket to the credential helper
automatically widens the next mint.

Every step verifies by exercise, and the install path rolls back if the new token is worse.
"""
from __future__ import annotations
import json, subprocess, sys, urllib.error, urllib.request

ADDR = "http://127.0.0.1:9095"        # ess-proxy -> openbao (openbao's own port is unpublished)
VHOST = "vault.example.com"           # ess-proxy is name-based
WORKBOX = "work-box"
PERIOD = "768h"


def api(token, method, path, payload=None):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(f"{ADDR}/v1/{path}", data=data, method=method)
    req.add_header("X-Vault-Token", token)
    req.add_header("Host", VHOST)
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            body = r.read().decode()
            return (r.status, json.loads(body) if body.strip() else {})
    except urllib.error.HTTPError as e:
        try:
            return (e.code, json.loads(e.read().decode()))
        except Exception:
            return (e.code, {})
    except Exception as e:
        return (0, {"errors": [str(e)]})


def ssh(cmd, stdin=None):
    return subprocess.run(["ssh", "-o", "BatchMode=yes", "--", WORKBOX, cmd],
                          input=stdin, capture_output=True, text=True, timeout=180)


def step(n, msg):
    print(f"\n[{n}] {msg}", flush=True)


def main() -> int:
    admin = sys.stdin.read().strip()
    if not admin:
        print("no admin token on stdin", file=sys.stderr)
        return 2

    step(1, "checking the supplied token can administer policies")
    code, body = api(admin, "POST", "sys/capabilities-self",
                     {"paths": ["sys/policies/acl/scm-read"]})
    caps = (body.get("data") or body).get("sys/policies/acl/scm-read", []) if code == 200 else []
    if not any(c in caps for c in ("create", "update", "root", "sudo")):
        print(f"    that token cannot write policies (HTTP {code}, caps={caps}).\n"
              f"    Use the BREAK-GLASS token or a fresh `operator` userpass login.",
              file=sys.stderr)
        return 2
    print(f"    OK (caps on policy path: {caps})")

    step(2, "deriving required vault paths from the credential helper itself (single source of truth)")
    r = ssh("credential-helper paths")
    rows = [ln.split() for ln in r.stdout.splitlines() if len(ln.split()) == 3]
    if not rows:
        print("    `credential-helper paths` returned nothing; is work-box reachable?", file=sys.stderr)
        return 2
    vpaths = sorted({vp for (_b, _k, vp) in rows})
    for vp in vpaths:
        who = ", ".join(sorted({b for (b, _k, v) in rows if v == vp}))
        print(f"    {vp:<32} <- {who}")

    step(3, "writing the scm-read policy (read-only, exactly those paths)")
    rules = []
    for vp in vpaths:
        mount, _, rest = vp.partition("/")
        rules += [f'path "{mount}/data/{rest}" {{ capabilities = ["read"] }}',
                  f'path "{mount}/metadata/{rest}" {{ capabilities = ["read"] }}']
    code, _ = api(admin, "PUT", "sys/policies/acl/scm-read",
                  {"policy": "\n".join(rules) + "\n"})
    if code not in (200, 204):
        print(f"    FAILED to write policy (HTTP {code})", file=sys.stderr)
        return 1
    print(f"    written: {len(vpaths)} paths, read-only")

    step(4, "confirming work-ops still exists (the shared-ops write scope)")
    code, _ = api(admin, "GET", "sys/policies/acl/work-ops")
    if code != 200:
        api(admin, "PUT", "sys/policies/acl/work-ops", {"policy":
            'path "shared-ops/data/*" { capabilities = ["read","create","update"] }\n'
            'path "shared-ops/metadata/*" { capabilities = ["read","list"] }\n'
            'path "acme/data/*" { capabilities = ["read"] }\n'
            'path "acme/metadata/*" { capabilities = ["read","list"] }\n'})
        print("    was missing -> recreated")
    else:
        print("    present")

    step(5, "minting work-box's token with BOTH policies (the step that got fumbled)")
    code, body = api(admin, "POST", "auth/token/create",
                     {"policies": ["work-ops", "scm-read", "default"],
                      "period": PERIOD, "no_parent": True, "display_name": "work-ops"})
    tok = ((body.get("auth") or {}).get("client_token"))
    if not tok:
        print(f"    mint FAILED (HTTP {code}): {body.get('errors')}", file=sys.stderr)
        return 1
    print(f"    minted: orphan, periodic {PERIOD}, policies=work-ops+scm-read+default")

    step(6, "installing on work-box (handles the `export` prefix; verifies; rolls back)")
    r = ssh("set-vault-token", stdin=tok)
    print("    " + "\n    ".join((r.stdout + r.stderr).strip().splitlines()))
    if r.returncode != 0:
        print("    INSTALL FAILED -- previous token restored.", file=sys.stderr)
        return 1

    step(7, "clearing the credential helper's token cache so the fix is visible immediately")
    ssh("rm -f /dev/shm/credential-helper-tok-*")
    print("    cleared (cached App tokens live 55min and would mask the fix)")

    step(8, "minting hub-box's own ops token (raft snapshot -- DR has been dead 10 days)")
    api(admin, "PUT", "sys/policies/acl/hub-ops", {"policy":
        'path "sys/storage/raft/snapshot" { capabilities = ["read"] }\n'
        'path "shared-ops/data/*" { capabilities = ["read"] }\n'
        'path "shared-ops/metadata/*" { capabilities = ["read","list"] }\n'})
    code, body = api(admin, "POST", "auth/token/create",
                     {"policies": ["hub-ops", "default"], "period": PERIOD,
                      "no_parent": True, "display_name": "hub-ops"})
    atok = ((body.get("auth") or {}).get("client_token"))
    if atok:
        p = subprocess.run(["set-vault-token", "--no-verify"],
                           input=atok, capture_output=True, text=True)
        print("    " + "\n    ".join((p.stdout + p.stderr).strip().splitlines()))
    else:
        print(f"    mint FAILED (HTTP {code}) -- snapshots stay broken", file=sys.stderr)

    step(9, "verifying by exercise: the credential helper, the probe, the deploy credential, DR")
    r = ssh("vault-credential-probe >/dev/null 2>&1; echo probe=$?; "
            "credential-helper list 2>&1 | sed 's/^/      /'; "
            "systemctl start prodbox-github-token.service >/dev/null 2>&1; "
            "echo prodbox=$(systemctl is-failed prodbox-github-token.service)")
    print("    " + "\n    ".join((r.stdout + r.stderr).strip().splitlines()))
    s = subprocess.run(["/root/openbao-snapshot.sh"], capture_output=True, text=True)
    print(f"    snapshot exit={s.returncode}")
    print("\nDone. If probe=0 and no bucket says MISSING/NO CRED, every repo can arm again.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
